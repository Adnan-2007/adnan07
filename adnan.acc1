<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#050505">
<title>عدنان</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#050505;--red:#e10600;--blood:#8f0014;--glow:rgba(225,6,0,.45);--text:#f4eded;--mute:#a99a9a}
*{box-sizing:border-box;margin:0}
body{min-height:100svh;background:radial-gradient(120% 80% at 50% -10%,#3a0008 0,var(--ink) 60%) fixed;color:var(--text);font-family:'Cairo',system-ui,sans-serif;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(420px circle at var(--mx,50%) var(--my,30%),rgba(225,6,0,.13),transparent 70%)}
#fx{position:fixed;inset:0;z-index:0;pointer-events:none}
main{position:relative;z-index:1;max-width:460px;margin:0 auto;padding:max(44px,env(safe-area-inset-top)) 20px max(40px,env(safe-area-inset-bottom));text-align:center}

/* الدخولية: ستارة ملكية */
#gate{position:fixed;inset:0;z-index:50;display:grid;place-items:center}
.curtain{position:absolute;top:0;bottom:0;width:50.5%;transition:transform 1.5s cubic-bezier(.76,0,.24,1);
 background:linear-gradient(90deg,rgba(0,0,0,.55),transparent 30%,transparent 70%,rgba(0,0,0,.55)),repeating-linear-gradient(90deg,#4a000d 0 18px,#2b0006 18px 34px,#5c0011 34px 44px)}
.curtain.l{left:0;border-right:2px solid var(--red)}
.curtain.r{right:0;border-left:2px solid var(--red)}
.crest{position:relative;z-index:2;text-align:center;transition:opacity .6s,transform 1s}
.crown{width:112px;filter:drop-shadow(0 0 14px rgba(225,6,0,.8))}
.crown path{stroke:var(--text);stroke-width:1.1;stroke-linejoin:round;fill:rgba(225,6,0,0);stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.8s .3s ease forwards,fillin 1s 1.8s forwards}
.gname{font:700 2.4rem 'Reem Kufi',serif;margin-top:6px;opacity:0;animation:fade 1s 1.6s forwards}
#gate.open{pointer-events:none}
#gate.open .l{transform:translateX(-101%)}
#gate.open .r{transform:translateX(101%)}
#gate.open .crest{opacity:0;transform:scale(1.35)}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fillin{to{fill:rgba(225,6,0,.35)}}
@keyframes fade{to{opacity:1}}

/* ظهور المحتوى */
body:not(.in) .rise{opacity:0}
.in .rise{animation:rise 1s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i)*.13s)}
@keyframes rise{from{opacity:0;transform:translateY(26px) scale(.98)}}

/* البروفايل */
.avatar{margin-bottom:20px}
.frame{width:136px;height:136px;margin:auto;position:relative;border-radius:50%;background:#120004;display:grid;place-items:center;animation:pulse 3.4s ease-in-out infinite;box-shadow:0 0 28px rgba(225,6,0,.35)}
.frame::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(var(--red),#000,var(--blood),#000,var(--red));animation:spin 5s linear infinite;
 -webkit-mask:radial-gradient(farthest-side,#0000 calc(100% - 4px),#000 calc(100% - 3px));mask:radial-gradient(farthest-side,#0000 calc(100% - 4px),#000 calc(100% - 3px))}
.frame img{position:absolute;inset:8px;width:calc(100% - 16px);height:calc(100% - 16px);object-fit:cover;border-radius:50%}
.frame span{font:700 3.4rem 'Reem Kufi',serif;color:var(--red)}
@keyframes spin{to{transform:rotate(1turn)}}
@keyframes pulse{50%{box-shadow:0 0 54px rgba(225,6,0,.6)}}
h1{font:700 2.1rem 'Reem Kufi',serif;text-shadow:0 0 24px rgba(225,6,0,.55)}
.bio{color:var(--mute);line-height:1.9;max-width:34ch;margin:8px auto 0}
.bar{width:64px;height:2px;margin:20px auto 26px;background:linear-gradient(90deg,transparent,var(--red),transparent)}

/* الروابط */
ul{list-style:none;padding:0;display:grid;gap:14px}
.card{position:relative;display:flex;align-items:center;gap:16px;padding:12px 14px;border-radius:18px;text-align:right;color:inherit;text-decoration:none;
 background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.01));border:1px solid rgba(225,6,0,.3);
 transition:transform .35s,border-color .35s,box-shadow .35s;-webkit-tap-highlight-color:transparent}
.card:hover,.card:focus-visible{transform:translateY(-3px);border-color:var(--red);box-shadow:0 12px 32px -10px var(--glow);outline:none}
.card:focus-visible{outline:2px solid var(--text);outline-offset:3px}
.tile{position:relative;flex:none;width:58px;height:58px;border-radius:16px;display:grid;place-items:center;background:var(--bg);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14)}
.tile svg{width:32px;height:32px}
.txt{flex:1;min-width:0;display:grid}
.txt b{font-size:1.06rem}
.txt small{color:var(--mute);direction:ltr;text-align:right}
.chev{width:20px;height:20px;flex:none;opacity:.55;fill:none;stroke:var(--text);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.card:hover .tile{animation:wob .9s ease-in-out}
.tile.squish{animation:squish .8s cubic-bezier(.3,1.6,.5,1)}
.ring{position:absolute;inset:0;border-radius:inherit;border:2px solid var(--b);pointer-events:none;animation:ring 1.1s ease-out both}
@keyframes wob{25%{border-radius:30px 12px 28px 14px;transform:rotate(-4deg) scale(1.07)}50%{border-radius:14px 30px 12px 28px;transform:rotate(3deg) scale(1.09)}}
@keyframes squish{0%{transform:scale(1)}30%{transform:scale(.8,1.15);border-radius:50%}60%{transform:scale(1.15,.9)}100%{transform:scale(1)}}
@keyframes ring{from{transform:scale(1);opacity:.9}to{transform:scale(7);opacity:0}}

/* مكان الكتابة */
.note{margin-top:34px;padding:18px 20px;text-align:right;border-radius:18px;background:rgba(225,6,0,.06);border:1px solid rgba(225,6,0,.25);border-right:3px solid var(--red)}
.note h2{font:700 1.05rem 'Reem Kufi',serif;color:#ff4b44;margin-bottom:6px}
.note p{line-height:1.9}
footer{margin-top:28px;color:var(--mute);font-size:.85rem}

@media (prefers-reduced-motion:reduce){*,*::before{animation-duration:.01ms!important;animation-delay:0s!important;transition-duration:.01ms!important}}
</style>
</head>
<body>

<!-- الدخولية -->
<div id="gate">
  <div class="curtain l"></div><div class="curtain r"></div>
  <div class="crest">
    <svg class="crown" viewBox="0 0 24 24" fill="none">
      <path pathLength="1" d="M3.5 18.5 5 8l4.5 4.5L12 5l2.5 7.5L19 8l1.5 10.5z"/>
      <path pathLength="1" d="M4 21h16"/>
    </svg>
    <div class="gname">عدنان</div>
  </div>
</div>

<canvas id="fx"></canvas>

<main>
  <!-- الصورة الشخصية: ضع صورتك في نفس المجلد باسم profile.jpg -->
  <div class="rise avatar" style="--i:0">
    <div class="frame"><span>ع</span><img src="profile.jpg" alt="" onerror="this.remove()"></div>
  </div>

  <h1 class="rise" style="--i:1">عدنان</h1>
  <!-- التعريف: اكتب عن حالك هون -->
  <p class="bio rise" style="--i:2">هون بتكتب تعريف قصير عن حالك: شو بتشتغل، شو بتحب، وشو بدك الناس يعرفوا عنك.</p>
  <div class="bar rise" style="--i:2"></div>

  <ul>
    <li class="rise" style="--i:3"><a class="card" data-k="snap" href="#">
      <span class="tile" style="--bg:#FFFC00;--b:#FFFC00"><svg viewBox="0 0 24 24"><path fill="#fff" stroke="#000" stroke-width="1.2" stroke-linejoin="round" d="M12 3c-2.8 0-4.6 2-4.6 4.8 0 .8.1 1.6.1 2.3-.5.1-1.4-.4-1.8-.2-.4.2-.4.8.2 1.1.5.3 1.4.4 1.4.9 0 .8-1.8 2.8-3.5 3.1-.4.1-.4.6 0 .9.7.4 1.7.5 2.2.6.2.5.1 1.1.7 1.2.8.1 1.8-.3 2.8.1C11 20 11.2 21 12 21s1-.9 2.6-1.4c1-.4 2 0 2.8-.1.6-.1.5-.7.7-1.2.5-.1 1.5-.2 2.2-.6.4-.3.4-.8 0-.9-1.7-.3-3.5-2.3-3.5-3.1 0-.5.9-.6 1.4-.9.6-.3.6-.9.2-1.1-.4-.2-1.3.3-1.8.2 0-.7.1-1.5.1-2.3C16.6 5 14.8 3 12 3z"/></svg></span>
      <span class="txt"><b>سناب شات</b><small></small></span>
      <svg class="chev" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></a></li>

    <li class="rise" style="--i:4"><a class="card" data-k="insta" href="#">
      <span class="tile" style="--bg:linear-gradient(45deg,#feda75,#fa7e1e 25%,#d62976 50%,#962fbf 75%,#4f5bd5);--b:#d62976"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.7"/><circle cx="16.8" cy="7.2" r="1.1" fill="#fff" stroke="none"/></svg></span>
      <span class="txt"><b>إنستغرام</b><small></small></span>
      <svg class="chev" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></a></li>

    <li class="rise" style="--i:5"><a class="card" data-k="threads" href="#">
      <span class="tile" style="--bg:#000;--b:#fff"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.3 9.3C16.6 6.8 14.8 5.4 12.1 5.4 8.5 5.4 6.4 8.1 6.4 12s2.1 6.6 5.8 6.6c2.7 0 4.6-1.4 4.6-3.500 0-2.400-2.200-3.400-4.400-3.200-1.600.1-2.600.9-2.600 2 0 1 .8 1.600 1.900 1.600 1.800 0 2.700-1.300 2.700-3.600 0-2.100-1-3-2.800-3"/></svg></span>
      <span class="txt"><b>ثريدز</b><small></small></span>
      <svg class="chev" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></a></li>

    <li class="rise" style="--i:6"><a class="card" data-k="linkedin" href="#">
      <span class="tile" style="--bg:#0A66C2;--b:#3b8de0"><svg viewBox="0 0 24 24" fill="#fff"><circle cx="6.2" cy="6.4" r="2"/><rect x="4.4" y="9.2" width="3.6" height="10.8" rx=".3"/><path d="M10.2 9.2h3.4v1.5c.5-.9 1.7-1.800 3.500-1.800 3.600 0 4.200 2.300 4.200 5.400V20h-3.600v-5.200c0-1.300 0-2.800-1.800-2.800s-2.200 1.300-2.200 2.700V20h-3.500z"/></svg></span>
      <span class="txt"><b>لينكد إن</b><small></small></span>
      <svg class="chev" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></a></li>
  </ul>

  <!-- مكان كتابتك: غيّر العنوان والنص متل ما بدك -->
  <section class="note rise" style="--i:7">
    <h2>كلمة</h2>
    <p>هون المكان اللي بتكتب فيه اللي بدك ياه: رسالة، اقتباس، أو أي شي بدك الزوار يقروه.</p>
  </section>

  <footer class="rise" style="--i:8">© عدنان</footer>
</main>

<script>
/* ===== حط يوزراتك هون (بدون @) ===== */
const USERS = {
  snap: 'USERNAME',
  insta: 'USERNAME',
  threads: 'USERNAME',
  linkedin: 'USERNAME'
};
/* ================================== */

const BASE = {
  snap: 'https://www.snapchat.com/add/',
  insta: 'https://www.instagram.com/',
  threads: 'https://www.threads.com/@',
  linkedin: 'https://www.linkedin.com/in/'
};
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* الدخولية */
const gate = document.getElementById('gate');
let opened = false;
function openGate(){
  if (opened) return; opened = true;
  gate.classList.add('open');
  setTimeout(() => document.body.classList.add('in'), 700);
  setTimeout(() => gate.remove(), 1900);
}
setTimeout(openGate, reduced ? 0 : 3000);
gate.addEventListener('click', openGate);

/* الروابط + تأثير التموج */
function wave(tile){
  tile.classList.remove('squish'); void tile.offsetWidth; tile.classList.add('squish');
  for (let i = 0; i < 3; i++){
    const r = document.createElement('span');
    r.className = 'ring'; r.style.animationDelay = (i * .16) + 's';
    tile.appendChild(r); setTimeout(() => r.remove(), 1600);
  }
}
document.querySelectorAll('.card').forEach(a => {
  const k = a.dataset.k, u = USERS[k];
  a.href = BASE[k] + u;
  a.querySelector('small').textContent = (k === 'linkedin' ? '' : '@') + u;
  a.addEventListener('click', e => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
    e.preventDefault();
    wave(a.querySelector('.tile'));
    setTimeout(() => { location.href = a.href; }, 850);
  });
});

/* توهج يتبع المؤشر */
addEventListener('pointermove', e => {
  document.body.style.setProperty('--mx', e.clientX + 'px');
  document.body.style.setProperty('--my', e.clientY + 'px');
});

/* شرر أحمر يطلع للأعلى */
if (!reduced){
  const c = document.getElementById('fx'), x = c.getContext('2d');
  let W, H, P = [];
  const size = () => { W = c.width = innerWidth; H = c.height = innerHeight; };
  const mk = r => ({x: Math.random() * W, y: r ? Math.random() * H : H + 10, s: Math.random() * 2 + .6, v: Math.random() * .5 + .2, a: Math.random() * .6 + .2, p: Math.random() * 6});
  size(); addEventListener('resize', size);
  for (let i = 0; i < 42; i++) P.push(mk(true));
  (function tick(){
    x.clearRect(0, 0, W, H);
    for (const p of P){
      p.y -= p.v; p.p += .02; p.x += Math.sin(p.y / 60 + p.p) * .3;
      if (p.y < -10) Object.assign(p, mk(false));
      x.beginPath(); x.arc(p.x, p.y, p.s, 0, 7);
      x.fillStyle = `rgba(255,${40 + p.s * 20 | 0},20,${p.a * (.6 + .4 * Math.sin(p.p * 3))})`;
      x.shadowBlur = 10; x.shadowColor = '#e10600'; x.fill();
    }
    requestAnimationFrame(tick);
  })();
}
</script>
</body>
</html>
